generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id               String         @id @default(uuid())
  name             String
  mobileNumber     String
  email            String?
  projectLocation  String?
  requirement      String
  projectDetails   String?
  submissionSource String
  promoCode        String?
  createdAt        DateTime       @default(now())
  status           String         @default("New Lead")
  handledBy        String?        @default("Unassigned")
  notes            Json?          @default("[]")
  source           String         @default("Website")
  areaSqft         String?
  assignedBy       String?
  reminderDateTime DateTime?
  reminderSent     Boolean        @default(false)
  isPinned         Boolean        @default(false)
  isTrashed        Boolean        @default(false)
  activities       LeadActivity[]
  messages         LeadMessage[]
  transfers        LeadTransfer[]
  notifications    Notification[]
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  type      String
  fromUser  String?
  toUser    String?
  note      String?
  createdAt DateTime @default(now())
  lead      Lead     @relation(fields: [leadId], references: [id])
}

model LeadTransfer {
  id           String    @id @default(uuid())
  leadId       String
  fromEmployee String
  toEmployee   String
  note         String?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  lead         Lead      @relation(fields: [leadId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  username  String
  leadId    String?
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  lead      Lead?    @relation(fields: [leadId], references: [id])
}

model LeadMessage {
  id             String   @id @default(uuid())
  leadId         String
  author         String
  text           String?
  attachmentUrl  String?
  attachmentType String?
  createdAt      DateTime @default(now())
  lead           Lead     @relation(fields: [leadId], references: [id])
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  name      String?
  email     String?  @unique
  password  String?
  pin       String
  role      String   @default("Employee")
  avatarUrl String?
  status    String   @default("Active")
  createdAt DateTime @default(now())
}

model AdminAuditLog {
  id            String   @id @default(uuid())
  adminUsername String
  action        String
  targetType    String
  targetId      String?
  details       String?
  timestamp     DateTime @default(now())
}

model PushSubscription {
  id        String   @id @default(uuid())
  username  String
  endpoint  String
  auth      String
  p256dh    String
  createdAt DateTime @default(now())
  
  @@unique([username, endpoint])
}
